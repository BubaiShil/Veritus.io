# =============================================================================
# Veritus Environment Configuration (.env)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# LOCAL DOCKER:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_data_analyst
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_data_analyst

# PRODUCTION (e.g. Neon, Supabase, Render PostgreSQL):
# Replace with your managed PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# 2. AI Engine Configuration (Gemini or Ollama)
# -----------------------------------------------------------------------------
# CLOUD LLM (RECOMMENDED FOR PRODUCTION & CLOUD DEPLOYMENT):
# Get free key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ALTERNATIVE CLOUD LLM (Groq):
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-70b-versatile

# LOCAL LLM (Ollama - fallback when GEMINI_API_KEY is not set):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# -----------------------------------------------------------------------------
# 3. CORS & Deployment Configuration
# -----------------------------------------------------------------------------
# FRONTEND_ORIGIN allows backend to accept requests from your frontend.
# Local dev: http://localhost:5173
# Production (Vercel): https://your-veritus-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Port for FastAPI server (Render sets PORT automatically)
PORT=8000
